# Backend: copy these values to backend/.env
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding modes: hash | local | api
# Local: EMBEDDING_MODE=local, EMBEDDING_MODEL=BAAI/bge-m3
# Render: EMBEDDING_MODE=api, EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_MODE=local
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3

# PDF chunking and retrieval
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TOP_K=5

# Frontend: place this value in frontend/.env.local
BACKEND_URL=http://127.0.0.1:8000
